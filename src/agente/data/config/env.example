# Copie para .env (git-ignorado). Segredos vivem SÓ aqui — nunca no código,
# no Git ou nos relatórios. O provedor de IA é escolhido após os prompts master.

# --- Provedor de IA (preencher depois) --------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Scanners / serviços externos (preencher se/quando usados) ---------------
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=

# --- Acesso a VPS (preferir chave SSH fora do repo; caminho, não a chave) ----
# VPS_SSH_KEY_PATH=
